{
  "name": "neuromind-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:grader-down": "E2E_GRADER_DOWN=1 playwright test -g E:",
    "build:mock": "VITE_SUPABASE_URL=https://mock.supabase.test VITE_SUPABASE_ANON_KEY=mock-anon VITE_API_BASE_URL=http://api.mock.test vite build",
    "test:ui": "playwright test -c playwright.ui.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@monaco-editor/react": "4.7.0",
    "@supabase/supabase-js": "2.49.1",
    "@tanstack/react-query": "5.66.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.1.5",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.19.0",
    "@playwright/test": "1.50.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "6.1.0",
    "vitest": "3.0.5"
  }
}